{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MoYu",
  "mainBinaryName": "moyu",
  "version": "0.1.10",
  "identifier": "com.moyu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14200",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "node scripts/update-copyright.js && pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "摩语 MoYu",
        "width": 960,
        "height": 680,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "BA8BAK",
    "shortDescription": "Professional Morse Code Training Terminal",
    "longDescription": "MoYu (摩语) - A Professional Morse Code Training Terminal with EPUB and TXT support.",
    "copyright": "Copyright © 2026 BA8BAK",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QzVBMkJGOUUyMjJDQTQKUldTa0xDS2V2NkxGNkFqaVpOTHhmd1NXOHdRT1NvNVVNSjJLVW0rWUpYMVorbzQ3aVJXdlRuNWwK",
      "endpoints": [
        "https://github.com/Ansen/MoYu/releases/latest/download/latest.json"
      ]
    }
  }
}