{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MoYu",
  "version": "0.1.0",
  "identifier": "com.moyu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "摩语 MoYu",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BA8BAK",
    "shortDescription": "Professional Morse Code Training Terminal",
    "longDescription": "MoYu (摩语) - A Professional Morse Code Training Terminal with EPUB and TXT support.",
    "copyright": "Copyright © 2026 BA8BAK",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
